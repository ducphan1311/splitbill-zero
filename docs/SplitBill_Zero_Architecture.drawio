<mxfile host="app.diagrams.net" modified="2026-10-28T09:00:00.000Z" agent="OpenClaw System Architect" version="24.7.5" type="device"><diagram id="splitbill-zero-architecture" name="SplitBill Zero Architecture &amp; Flow"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="header_title" value="⚡ SplitBill Zero — System Architecture &amp; Real-Time Collaborative Flow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Segoe UI,Helvetica,Arial;fontSize=24;fontStyle=1;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="40" y="25" width="1000" height="40" as="geometry" /></mxCell><mxCell id="header_sub" value="Production-grade zero-install architecture: Edge OCR (Flutter/ML Kit) ➔ Real-Time Mesh Sync ➔ Lightweight Guest Web Client ➔ Dynamic VietQR (EMVCo) Settlement" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Segoe UI,Helvetica,Arial;fontSize=13;fontColor=#64748B;" parent="1" vertex="1"><mxGeometry x="40" y="65" width="1200" height="25" as="geometry" /></mxCell><mxCell id="container_host" value="1. HOST MOBILE ENGINE (Native/Flutter App)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1;dashed=1;fontFamily=Segoe UI,Helvetica,Arial;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#F8FAFC;strokeColor=#0284C7;fontColor=#0369A1;" parent="1" vertex="1"><mxGeometry x="40" y="110" width="380" height="680" as="geometry" /></mxCell><mxCell id="container_realtime" value="2. REAL-TIME SESSION ENGINE (Cloud / Edge Mesh)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1;dashed=1;fontFamily=Segoe UI,Helvetica,Arial;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#F8FAFC;strokeColor=#6366F1;fontColor=#4338CA;" parent="1" vertex="1"><mxGeometry x="460" y="110" width="380" height="680" as="geometry" /></mxCell><mxCell id="container_guest" value="3. ZERO-INSTALL GUEST CLIENT (Mobile Web)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1;dashed=1;fontFamily=Segoe UI,Helvetica,Arial;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#F8FAFC;strokeColor=#10B981;fontColor=#047857;" parent="1" vertex="1"><mxGeometry x="880" y="110" width="380" height="680" as="geometry" /></mxCell><mxCell id="container_fintech" value="4. FINTECH SETTLEMENT (VietQR / Napas 247)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeWidth=1;dashed=1;fontFamily=Segoe UI,Helvetica,Arial;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fillColor=#F8FAFC;strokeColor=#F59E0B;fontColor=#B45309;" parent="1" vertex="1"><mxGeometry x="1300" y="110" width="380" height="680" as="geometry" /></mxCell><mxCell id="n_cam" value="&lt;b&gt;Camera Stream Layer&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748B&quot;&gt;CameraX (Android) / AVFoundation (iOS)&lt;br/&gt;30fps YUV420 Image Analysis Buffer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Segoe UI,Helvetica,Arial;fontSize=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#0284C7;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="65" y="160" width="330" height="75" as="geometry" /></mxCell><mxCell id="n_ml" value="&lt;b&gt;Google ML Kit Text Recognition v2&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748B&quot;&gt;On-Device Edge OCR (Vietnamese Latin script)&lt;br/&gt;Latency &amp;lt; 50ms, Zero Cloud Cost&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Segoe UI,Helvetica,Arial;fontSize=12;strokeWidth=2;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0369A1;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="65" y="270" width="330" height="80" as="geometry" /></mxCell><mxCell id="n_parser" value="&lt;b&gt;Bill Parser &amp; Line RegEx Matcher&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748B&quot;&gt;Spatial Bounding Box Clustering&lt;br/&gt;Item Name + Price (VND) Normalizer&lt;br/&gt;Tax &amp; Surcharge Distributer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Segoe UI,Helvetica,Arial;fontSize=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#0284C7;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="65" y="385" width="330" height="90" as="geometry" /></mxCell><mxCell id="n_room_init" value="&lt;b&gt;Room Session Dispatcher&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748B&quot;&gt;Generate 6-character Short Code &amp; URL&lt;br/&gt;Render Table Joining QR for Guests&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Segoe UI,Helvetica,Arial;fontSize=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#0284C7;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="65" y="510" width="330" height="75" as="geometry" /></mxCell><mxCell id="n_host_dash" value="&lt;b&gt;Host Live Dashboard&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748B&quot;&gt;Real-time Guest Tracker &amp; Settlement Status&lt;br/&gt;Sync Paid/Unpaid Badges via WebSocket&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Segoe UI,Helvetica,Arial;fontSize=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#0284C7;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="65" y="620" width="330" height="75" as="geometry" /></mxCell><mxCell id="n_rt_gateway" value="&lt;b&gt;Real-Time Room Gateway&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748B&quot;&gt;Supabase Realtime / WebSocket Mesh&lt;br/&gt;Topic: `room:${roomId}` Presence &amp; Broadcast&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Segoe UI,Helvetica,Arial;fontSize=12;strokeWidth=2;fillColor=#EEF2FF;strokeColor=#6366F1;fontColor=#3730A3;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="485" y="160" width="330" height="80" as="geometry" /></mxCell><mxCell id="n_state_store" value="&lt;b&gt;Ephemeral State Store (In-Memory / Redis)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748B&quot;&gt;`items`: [{id, name, price, shares: []}]&lt;br/&gt;`guests`: [{id, name, totalAmount, status}]&lt;br/&gt;TTL: 2 Hours auto-expiry (Privacy-first)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Segoe UI,Helvetica,Arial;fontSize=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#6366F1;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="485" y="280" width="330" height="95" as="geometry" /></mxCell><mxCell id="n_split_algo" value="&lt;b&gt;Fair Split Calculation Engine&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748B&quot;&gt;Direct Item Assignment: $Cost = Price$&lt;br/&gt;Shared Dishes: $Cost = Price / N_{guests}$&lt;br/&gt;Proportional Tax/Tips Allocation Matrix&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Segoe UI,Helvetica,Arial;fontSize=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#6366F1;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="485" y="415" width="330" height="90" as="geometry" /></mxCell><mxCell id="n_webhook" value="&lt;b&gt;Payment Event Webhook Listener&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748B&quot;&gt;Casso / Open Banking Webhook Listener&lt;br/&gt;Matches Transfer Note ➔ Emits `PAID` event&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Segoe UI,Helvetica,Arial;fontSize=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#6366F1;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="485" y="545" width="330" height="80" as="geometry" /></mxCell><mxCell id="n_qr_scan" value="&lt;b&gt;Guest Joins Table via Native QR Scan&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748B&quot;&gt;iPhone Camera / Android Lens / Zalo QR&lt;br/&gt;Direct deep-link to Web: `bill.io/r/XYZ123`&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Segoe UI,Helvetica,Arial;fontSize=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="905" y="160" width="330" height="75" as="geometry" /></mxCell><mxCell id="n_pwa" value="&lt;b&gt;Ultra-Lightweight Mobile Web Client&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748B&quot;&gt;Zero App Download | Zero Login Barrier&lt;br/&gt;React / Svelte / Flutter Web (Bundle &amp;lt; 250KB)&lt;br/&gt;Instant input: Enter Name &amp;amp; Start Picking&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Segoe UI,Helvetica,Arial;fontSize=12;strokeWidth=2;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#065F46;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="905" y="270" width="330" height="85" as="geometry" /></mxCell><mxCell id="n_item_picker" value="&lt;b&gt;Real-Time Interactive Dish Board&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748B&quot;&gt;Tap to claim item | Multiple select for shared&lt;br/&gt;Live avatars showing who picked what&lt;br/&gt;Optimistic UI updates + Haptic feedback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Segoe UI,Helvetica,Arial;fontSize=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="905" y="395" width="330" height="85" as="geometry" /></mxCell><mxCell id="n_guest_pay" value="&lt;b&gt;Guest Breakdown &amp;amp; Pay Action&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748B&quot;&gt;1-Click &quot;Pay via Bank App&quot; (Deep Link)&lt;br/&gt;Displays Personalized Dynamic VietQR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Segoe UI,Helvetica,Arial;fontSize=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#10B981;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="905" y="520" width="330" height="75" as="geometry" /></mxCell><mxCell id="n_emvco" value="&lt;b&gt;EMVCo / VietQR Specification Encoder&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748B&quot;&gt;Tag 00: Payload Format Indicator (01)&lt;br/&gt;Tag 26: NAPAS Merchant Identifier (BNK ID + ACC)&lt;br/&gt;Tag 53: Transaction Currency (704 = VND)&lt;br/&gt;Tag 54: Precise Exact Amount (e.g. 84,500)&lt;br/&gt;Tag 62: Additional Data (Bill ID + Guest Name)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Segoe UI,Helvetica,Arial;fontSize=12;strokeWidth=2;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1325" y="160" width="330" height="135" as="geometry" /></mxCell><mxCell id="n_crc16" value="&lt;b&gt;CRC-16 / CCITT-FALSE Verification&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748B&quot;&gt;Polynomial 0x1021 Checksum Generation&lt;br/&gt;Ensures 100% Banking App Scanning Accuracy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Segoe UI,Helvetica,Arial;fontSize=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#F59E0B;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="1325" y="330" width="330" height="75" as="geometry" /></mxCell><mxCell id="n_bank_app" value="&lt;b&gt;Guest Banking Apps (40+ VN Banks)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748B&quot;&gt;Vietcombank, Techcombank, VPBank, MBBank...&lt;br/&gt;Auto-populates: Recipient, Amount, Transfer Note&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Segoe UI,Helvetica,Arial;fontSize=12;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#F59E0B;fontColor=#0F172A;" parent="1" vertex="1"><mxGeometry x="1325" y="440" width="330" height="75" as="geometry" /></mxCell><mxCell id="n_settle_confirm" value="&lt;b&gt;Instant Settlement &amp;amp; Auto-Reconcile&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#64748B&quot;&gt;Money landed on Host Bank Account&lt;br/&gt;Web &amp;amp; App UI instant green checkmark&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Segoe UI,Helvetica,Arial;fontSize=12;strokeWidth=2;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#065F46;fontStyle=1;" parent="1" vertex="1"><mxGeometry x="1325" y="550" width="330" height="75" as="geometry" /></mxCell><mxCell id="e1" value="Image Frames (YUV)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0284C7;fontColor=#0284C7;dashed=0;" parent="1" source="n_cam" target="n_ml" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="Text Blocks + Boxes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0284C7;fontColor=#0284C7;dashed=0;" parent="1" source="n_ml" target="n_parser" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="Parsed Receipt JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0284C7;fontColor=#0284C7;dashed=0;" parent="1" source="n_parser" target="n_room_init" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="POST Create Room (Items + Host Info)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6366F1;fontColor=#6366F1;dashed=0;" parent="1" source="n_room_init" target="n_rt_gateway" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="Cache Session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6366F1;fontColor=#6366F1;dashed=0;" parent="1" source="n_rt_gateway" target="n_state_store" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="Display Join QR on Host Screen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#10B981;fontColor=#10B981;dashed=1;" parent="1" source="n_room_init" target="n_qr_scan" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="Open Browser Session" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#10B981;fontColor=#10B981;dashed=0;" parent="1" source="n_qr_scan" target="n_pwa" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="Guest Profile Created" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#10B981;fontColor=#10B981;dashed=0;" parent="1" source="n_pwa" target="n_item_picker" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="WebSocket: `select_item` / `unselect`" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6366F1;fontColor=#6366F1;dashed=0;" parent="1" source="n_item_picker" target="n_rt_gateway" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="Recalculate Split" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#6366F1;fontColor=#6366F1;dashed=0;" parent="1" source="n_rt_gateway" target="n_split_algo" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="Broadcast Updated Table State" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#0284C7;fontColor=#0284C7;dashed=0;" parent="1" source="n_split_algo" target="n_host_dash" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="Guest Clicks &quot;Confirm &amp; Pay&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#10B981;fontColor=#10B981;dashed=0;" parent="1" source="n_item_picker" target="n_guest_pay" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="Amount + Host Acc + Ref Note" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#F59E0B;fontColor=#F59E0B;dashed=0;" parent="1" source="n_guest_pay" target="n_emvco" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="Raw Payload String" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#F59E0B;fontColor=#F59E0B;dashed=0;" parent="1" source="n_emvco" target="n_crc16" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="Render Dynamic VietQR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#F59E0B;fontColor=#F59E0B;dashed=0;" parent="1" source="n_crc16" target="n_bank_app" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="Napas 247 Instant Transfer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#059669;fontColor=#059669;dashed=0;" parent="1" source="n_bank_app" target="n_settle_confirm" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="Notification Webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#059669;fontColor=#059669;dashed=1;" parent="1" source="n_settle_confirm" target="n_webhook" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="Broadcast `PAID` State" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#059669;fontColor=#059669;dashed=0;" parent="1" source="n_webhook" target="n_host_dash" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>