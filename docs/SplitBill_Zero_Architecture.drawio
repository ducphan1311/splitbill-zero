<mxfile host="app.diagrams.net" modified="2026-10-28T09:30:00.000Z" agent="OpenClaw Enterprise Architect" version="24.7.5" type="device"><diagram id="splitbill-zero-enterprise-arch" name="SplitBill Zero Enterprise System Architecture"><mxGraphModel dx="2000" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="sub_client" value="&lt;b&gt;SUBSYSTEM A: CLIENT INTERACTION LAYER&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot; color=&quot;#0369A1&quot;&gt;Flutter Native Engine (Host) &amp; Zero-Install Guest Web Client&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;strokeWidth=1.5;dashed=1;strokeColor=#0284C7;fillColor=#F0F9FF;fontColor=#0369A1;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=12;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="40" y="100" width="420" height="680" as="geometry" /></mxCell><mxCell id="sub_edge" value="&lt;b&gt;SUBSYSTEM B: ON-DEVICE INGESTION &amp; OCR ENGINE&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot; color=&quot;#3730A3&quot;&gt;Edge AI Computer Vision &amp; Spatial Bounding-Box Heuristics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;strokeWidth=1.5;dashed=1;strokeColor=#4F46E5;fillColor=#EEF2FF;fontColor=#3730A3;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=12;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="490" y="100" width="430" height="680" as="geometry" /></mxCell><mxCell id="sub_mesh" value="&lt;b&gt;SUBSYSTEM C: COLLABORATIVE SESSION MESH&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot; color=&quot;#065F46&quot;&gt;Low-Latency PubSub, Ephemeral State Cache &amp; Matrix Math&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;strokeWidth=1.5;dashed=1;strokeColor=#059669;fillColor=#ECFDF5;fontColor=#065F46;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=12;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="950" y="100" width="430" height="680" as="geometry" /></mxCell><mxCell id="sub_fintech" value="&lt;b&gt;SUBSYSTEM D: BANKING &amp; SETTLEMENT GATEWAY&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:11px;font-weight:normal;&quot; color=&quot;#92400E&quot;&gt;EMVCo VietQR Tag Synthesis, CRC-16 Checksum &amp; Napas 247&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;strokeWidth=1.5;dashed=1;strokeColor=#D97706;fillColor=#FFFBEB;fontColor=#92400E;fontSize=13;align=left;verticalAlign=top;spacingLeft=18;spacingTop=12;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="1410" y="100" width="470" height="680" as="geometry" /></mxCell><mxCell id="main_header" value="&lt;b&gt;SPLITBILL ZERO: ENTERPRISE TECHNICAL ARCHITECTURE &amp; SUBSYSTEM SPECIFICATION&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:12px;font-weight:normal;&quot; color=&quot;#64748B&quot;&gt;Distributed Collaborative Financial Settlement Protocol | IEC/ISO 18004 &amp;amp; EMVCo Standard Compliant&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#0F172A;fontSize=18;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="40" y="30" width="1400" height="45" as="geometry" /></mxCell><mxCell id="c_flutter_host" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;font-weight:bold;font-size:12px;color:#0369A1;&quot;&gt;Host Application (Flutter 3.x)&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:9px;background:#0284C7;color:#ffffff;padding:2px 5px;border-radius:3px;font-weight:600;&quot;&gt;MOBILE HOST&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;font-size:10.5px;color:#64748B;padding-top:4px;line-height:1.35;&quot;&gt;Orchestrates camera sessions, room lifecycles, and final settlement confirmation on table master device.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.5;strokeColor=#0284C7;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="65" y="170" width="370" height="85" as="geometry" /></mxCell><mxCell id="c_guest_pwa" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;font-weight:bold;font-size:12px;color:#0369A1;&quot;&gt;Guest Web Client (Svelte / PWA)&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:9px;background:#0284C7;color:#ffffff;padding:2px 5px;border-radius:3px;font-weight:600;&quot;&gt;MOBILE WEB&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;font-size:10.5px;color:#64748B;padding-top:4px;line-height:1.35;&quot;&gt;Zero-install ephemeral web client (&lt;250KB bundle). Instantly loaded via QR scan with zero authentication friction.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.5;strokeColor=#0284C7;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="65" y="290" width="370" height="85" as="geometry" /></mxCell><mxCell id="c_state_view" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;font-weight:bold;font-size:12px;color:#0369A1;&quot;&gt;Real-Time Table Board (Virtual Dish Canvas)&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:9px;background:#0284C7;color:#ffffff;padding:2px 5px;border-radius:3px;font-weight:600;&quot;&gt;UI COMPONENT&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;font-size:10.5px;color:#64748B;padding-top:4px;line-height:1.35;&quot;&gt;Bidirectional synchronization of selected items with live peer avatars, shared indicators, and total cost preview.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.5;strokeColor=#0284C7;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="65" y="410" width="370" height="85" as="geometry" /></mxCell><mxCell id="c_deeplink_mgr" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;font-weight:bold;font-size:12px;color:#0369A1;&quot;&gt;Universal Bank Intent Dispatcher&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:9px;background:#0284C7;color:#ffffff;padding:2px 5px;border-radius:3px;font-weight:600;&quot;&gt;DEEPLINK&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;font-size:10.5px;color:#64748B;padding-top:4px;line-height:1.35;&quot;&gt;Dispatches direct iOS/Android URL schemes into VCB Digibank, Techcombank, VPBank NEO, and MBBank.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.5;strokeColor=#0284C7;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="65" y="530" width="370" height="85" as="geometry" /></mxCell><mxCell id="c_camerax" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;font-weight:bold;font-size:12px;color:#3730A3;&quot;&gt;Camera Pipeline (CameraX / AVFoundation)&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:9px;background:#4F46E5;color:#ffffff;padding:2px 5px;border-radius:3px;font-weight:600;&quot;&gt;HARDWARE API&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;font-size:10.5px;color:#64748B;padding-top:4px;line-height:1.35;&quot;&gt;High-speed 30fps YUV420 frame streaming with automatic exposure, focus lock, and perspective correction.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.5;strokeColor=#4F46E5;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="515" y="170" width="380" height="85" as="geometry" /></mxCell><mxCell id="c_mlkit_v2" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;font-weight:bold;font-size:12px;color:#3730A3;&quot;&gt;Google ML Kit Text Recognition v2&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:9px;background:#4F46E5;color:#ffffff;padding:2px 5px;border-radius:3px;font-weight:600;&quot;&gt;EDGE AI&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;font-size:10.5px;color:#64748B;padding-top:4px;line-height:1.35;&quot;&gt;On-device Latin &amp; Vietnamese script neural text extractor. Latency &lt;45ms, zero cloud telemetry, 100% privacy.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.5;strokeColor=#4F46E5;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="515" y="290" width="380" height="85" as="geometry" /></mxCell><mxCell id="c_spatial_cluster" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;font-weight:bold;font-size:12px;color:#3730A3;&quot;&gt;2D Geometric Spatial Clustering Engine&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:9px;background:#4F46E5;color:#ffffff;padding:2px 5px;border-radius:3px;font-weight:600;&quot;&gt;ALGORITHM&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;font-size:10.5px;color:#64748B;padding-top:4px;line-height:1.35;&quot;&gt;Clusters TextBlocks by vertical band (|ΔY| ≤ 0.5 * LineHeight) and correlates dish names with right-aligned numeric VND values.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.5;strokeColor=#4F46E5;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="515" y="410" width="380" height="95" as="geometry" /></mxCell><mxCell id="c_receipt_parser" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;font-weight:bold;font-size:12px;color:#3730A3;&quot;&gt;Receipt Normalizer &amp; Tax Allocator&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:9px;background:#4F46E5;color:#ffffff;padding:2px 5px;border-radius:3px;font-weight:600;&quot;&gt;BUSINESS LOGIC&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;font-size:10.5px;color:#64748B;padding-top:4px;line-height:1.35;&quot;&gt;Detects Subtotal, Service Charges, VAT (8-10%) tags and computes normalized BillItem entity collection.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.5;strokeColor=#4F46E5;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="515" y="540" width="380" height="85" as="geometry" /></mxCell><mxCell id="c_ws_gateway" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;font-weight:bold;font-size:12px;color:#065F46;&quot;&gt;WebSocket / Supabase Realtime Gateway&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:9px;background:#059669;color:#ffffff;padding:2px 5px;border-radius:3px;font-weight:600;&quot;&gt;WEBSOCKET&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;font-size:10.5px;color:#64748B;padding-top:4px;line-height:1.35;&quot;&gt;Low-latency pub/sub message broker routing ephemeral events under topic `room:${roomId}`.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.5;strokeColor=#059669;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="975" y="170" width="380" height="85" as="geometry" /></mxCell><mxCell id="c_mem_cache" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;font-weight:bold;font-size:12px;color:#065F46;&quot;&gt;In-Memory Session Store (Redis / Edge KV)&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:9px;background:#059669;color:#ffffff;padding:2px 5px;border-radius:3px;font-weight:600;&quot;&gt;EPHEMERAL CACHE&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;font-size:10.5px;color:#64748B;padding-top:4px;line-height:1.35;&quot;&gt;Holds volatile room entities: Table metadata, Guest presence, Item claims. Configured with 2-hour TTL auto-eviction.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.5;strokeColor=#059669;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="975" y="290" width="380" height="85" as="geometry" /></mxCell><mxCell id="c_math_matrix" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;font-weight:bold;font-size:12px;color:#065F46;&quot;&gt;Fair-Split Deterministic Math Matrix&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:9px;background:#059669;color:#ffffff;padding:2px 5px;border-radius:3px;font-weight:600;&quot;&gt;FINANCIAL MATH&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;font-size:10.5px;color:#64748B;padding-top:4px;line-height:1.35;&quot;&gt;Formula: Cost = Σ(Private) + Σ(Shared / N_claimants) + Proportional VAT. Guarantees zero round-off discrepancy down to 1 VND.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.5;strokeColor=#059669;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="975" y="410" width="380" height="95" as="geometry" /></mxCell><mxCell id="c_presence_tracker" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;font-weight:bold;font-size:12px;color:#065F46;&quot;&gt;Guest Presence &amp; Heartbeat Daemon&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:9px;background:#059669;color:#ffffff;padding:2px 5px;border-radius:3px;font-weight:600;&quot;&gt;DISTRIBUTED STATE&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;font-size:10.5px;color:#64748B;padding-top:4px;line-height:1.35;&quot;&gt;Monitors peer disconnections, socket reconnects, and maintains authoritative active participant list.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.5;strokeColor=#059669;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="975" y="540" width="380" height="85" as="geometry" /></mxCell><mxCell id="c_emvco_tlv" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;font-weight:bold;font-size:12px;color:#92400E;&quot;&gt;EMVCo QR Tag Synthesizer (NAPAS 247)&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:9px;background:#D97706;color:#ffffff;padding:2px 5px;border-radius:3px;font-weight:600;&quot;&gt;EMVCo STANDARDS&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;font-size:10.5px;color:#64748B;padding-top:4px;line-height:1.35;&quot;&gt;Encodes standard Tag-Length-Value hierarchy: Tag 00 (Format), Tag 26 (Acquiring Bank BIN + Host Account), Tag 53 (704 VND), Tag 54 (Amount).&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.5;strokeColor=#D97706;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="1435" y="170" width="420" height="95" as="geometry" /></mxCell><mxCell id="c_crc16_engine" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;font-weight:bold;font-size:12px;color:#92400E;&quot;&gt;CRC-16 / CCITT-FALSE Checksum Engine&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:9px;background:#D97706;color:#ffffff;padding:2px 5px;border-radius:3px;font-weight:600;&quot;&gt;CRYPTOGRAPHY&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;font-size:10.5px;color:#64748B;padding-top:4px;line-height:1.35;&quot;&gt;Computes standard 16-bit redundancy polynomial 0x1021. Guarantees 100% scanning validity on all banking scanners.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.5;strokeColor=#D97706;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="1435" y="295" width="420" height="85" as="geometry" /></mxCell><mxCell id="c_vietqr_renderer" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;font-weight:bold;font-size:12px;color:#92400E;&quot;&gt;Dynamic QR Matrix Generator (ISO 18004)&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:9px;background:#D97706;color:#ffffff;padding:2px 5px;border-radius:3px;font-weight:600;&quot;&gt;GRAPHICS ENGINE&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;font-size:10.5px;color:#64748B;padding-top:4px;line-height:1.35;&quot;&gt;Vector-based QR matrix generator embedding custom Host branding logo and Napas 247 identity frame.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.5;strokeColor=#D97706;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="1435" y="410" width="420" height="85" as="geometry" /></mxCell><mxCell id="c_reconcile_wh" value="&lt;table style=&quot;width:100%;border-collapse:collapse;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;text-align:left;font-weight:bold;font-size:12px;color:#92400E;&quot;&gt;Payment Reconciliation Webhook / Poll&lt;/td&gt;&lt;td style=&quot;text-align:right;&quot;&gt;&lt;span style=&quot;font-size:9px;background:#D97706;color:#ffffff;padding:2px 5px;border-radius:3px;font-weight:600;&quot;&gt;RECONCILIATION&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan=&quot;2&quot; style=&quot;font-size:10.5px;color:#64748B;padding-top:4px;line-height:1.35;&quot;&gt;Parses incoming bank transaction references against guest claim tokens and automatically emits `PAID` confirmation.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeWidth=1.5;strokeColor=#D97706;fillColor=#FFFFFF;align=left;verticalAlign=middle;spacing=10;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" vertex="1"><mxGeometry x="1435" y="530" width="420" height="85" as="geometry" /></mxCell><mxCell id="l1" value="&lt;font style=&quot;font-size:10px;background:#ffffff;padding:1px 4px;border:1px solid #0284C7;border-radius:3px;&quot;&gt;1. Stream Frames&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#0284C7;fontColor=#0284C7;dashed=0;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" source="c_flutter_host" target="c_camerax" edge="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="l2" value="&lt;font style=&quot;font-size:10px;background:#ffffff;padding:1px 4px;border:1px solid #4F46E5;border-radius:3px;&quot;&gt;2. Buffer Ingestion&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;strokeColor=#4F46E5;fontColor=#4F46E5;dashed=0;fontFamily=SF Pro Display,-apple-system,BlinkMacSystemFont,Segoe UI,Helvetica,Arial;" parent="1" source="c_camerax" target="c_mlkit_v2" edge=