<mxfile host="app.diagrams.net" modified="2026-10-28T10:00:00.000Z" agent="OpenClaw System Architect" version="24.7.5" type="device"><diagram id="splitbill-zero-architecture-drawio-style" name="SplitBill Zero Architecture"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;SplitBill Zero: System Architecture &amp; Subsystem Interactions&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontColor=#000000;fontFamily=Helvetica,Arial,sans-serif;" parent="1" vertex="1"><mxGeometry x="40" y="30" width="800" height="30" as="geometry" /></mxCell><mxCell id="subtitle" value="Standard Architectural Decomposition: Client Layer | Ingestion &amp; Edge AI | Collaborative Mesh | Financial Settlement" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#555555;fontFamily=Helvetica,Arial,sans-serif;" parent="1" vertex="1"><mxGeometry x="40" y="60" width="1000" height="20" as="geometry" /></mxCell><mxCell id="sub_client" value="&lt;b&gt;Client Interaction Subsystem&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f8f9fa;strokeColor=#d6d8db;fontColor=#333333;fontSize=12;align=center;horizontal=1;startSize=28;arcSize=4;rounded=1;strokeWidth=1;fontFamily=Helvetica,Arial,sans-serif;" parent="1" vertex="1"><mxGeometry x="40" y="100" width="390" height="640" as="geometry" /></mxCell><mxCell id="sub_ocr" value="&lt;b&gt;Edge Ingestion &amp; OCR Subsystem&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f8f9fa;strokeColor=#d6d8db;fontColor=#333333;fontSize=12;align=center;horizontal=1;startSize=28;arcSize=4;rounded=1;strokeWidth=1;fontFamily=Helvetica,Arial,sans-serif;" parent="1" vertex="1"><mxGeometry x="460" y="100" width="420" height="640" as="geometry" /></mxCell><mxCell id="sub_mesh" value="&lt;b&gt;Collaborative Mesh Subsystem&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f8f9fa;strokeColor=#d6d8db;fontColor=#333333;fontSize=12;align=center;horizontal=1;startSize=28;arcSize=4;rounded=1;strokeWidth=1;fontFamily=Helvetica,Arial,sans-serif;" parent="1" vertex="1"><mxGeometry x="910" y="100" width="420" height="640" as="geometry" /></mxCell><mxCell id="sub_fintech" value="&lt;b&gt;Fintech Settlement Subsystem&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#f8f9fa;strokeColor=#d6d8db;fontColor=#333333;fontSize=12;align=center;horizontal=1;startSize=28;arcSize=4;rounded=1;strokeWidth=1;fontFamily=Helvetica,Arial,sans-serif;" parent="1" vertex="1"><mxGeometry x="1360" y="100" width="440" height="640" as="geometry" /></mxCell><mxCell id="c_host_app" value="&lt;b&gt;Host Application&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[Flutter 3.x Native Engine]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Manages bill capture, table initialization, and verifies peer settlement status.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_client" vertex="1"><mxGeometry x="25" y="45" width="340" height="85" as="geometry" /></mxCell><mxCell id="c_guest_pwa" value="&lt;b&gt;Guest Web Client&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[Svelte / PWA (&lt;250KB)]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Ephemeral mobile web app. First load &lt;800ms. Zero login or account requirements.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_client" vertex="1"><mxGeometry x="25" y="155" width="340" height="85" as="geometry" /></mxCell><mxCell id="c_dish_board" value="&lt;b&gt;Collaborative Dish Board&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[Real-Time UI Component]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Interactive canvas displaying scanned line items with real-time peer selection tags.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_client" vertex="1"><mxGeometry x="25" y="265" width="340" height="85" as="geometry" /></mxCell><mxCell id="c_deeplink" value="&lt;b&gt;Universal Bank Intent Router&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[Mobile OS Intent System]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Invokes registered banking app schemes on iOS/Android with pre-filled payment details.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_client" vertex="1"><mxGeometry x="25" y="375" width="340" height="85" as="geometry" /></mxCell><mxCell id="c_host_monitor" value="&lt;b&gt;Host Table Settlement Monitor&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[WebSocket Client Listener]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Live participant roster tracking paid vs. pending transfers with instant green checkmarks.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_client" vertex="1"><mxGeometry x="25" y="485" width="340" height="85" as="geometry" /></mxCell><mxCell id="o_cam_pipeline" value="&lt;b&gt;Frame Extraction Pipeline&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[CameraX / AVFoundation]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Captures 30fps YUV420 image buffers with hardware auto-focus and brightness normalization.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_ocr" vertex="1"><mxGeometry x="25" y="45" width="370" height="85" as="geometry" /></mxCell><mxCell id="o_mlkit" value="&lt;b&gt;On-Device Text Recognition&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[Google ML Kit Text v2]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Neural Latin/Vietnamese text recognition engine running offline on device NPU/CPU.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_ocr" vertex="1"><mxGeometry x="25" y="155" width="370" height="85" as="geometry" /></mxCell><mxCell id="o_clustering" value="&lt;b&gt;Spatial 2D Geometric Clustering&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[Spatial Heuristics]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Groups fragmented text blocks by vertical proximity and correlates item names with right-aligned numeric VND values.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_ocr" vertex="1"><mxGeometry x="25" y="265" width="370" height="85" as="geometry" /></mxCell><mxCell id="o_tax_parser" value="&lt;b&gt;Receipt Normalizer &amp; Tax Allocator&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[Normalization Engine]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Extracts and parses subtotal, VAT (8-10%), and service charges into structured BillItem entities.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_ocr" vertex="1"><mxGeometry x="25" y="375" width="370" height="85" as="geometry" /></mxCell><mxCell id="o_integrity_check" value="&lt;b&gt;Sum Discrepancy Validator&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[Integrity Checker]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Validates sum of parsed items against receipt grand total. Flags discrepancies for host confirmation.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_ocr" vertex="1"><mxGeometry x="25" y="485" width="370" height="85" as="geometry" /></mxCell><mxCell id="m_ws_gateway" value="&lt;b&gt;WebSocket Realtime Gateway&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[Supabase / Edge WS]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Low-latency bidirectional Pub/Sub message broker routing room state on topic `room:{roomId}`.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_mesh" vertex="1"><mxGeometry x="25" y="45" width="370" height="85" as="geometry" /></mxCell><mxCell id="m_state_cache" value="&lt;b&gt;In-Memory Session Store&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[Redis / Ephemeral KV]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Transient cache holding table state, line items, and guest claims. Configured with 2-hour TTL.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_mesh" vertex="1"><mxGeometry x="25" y="155" width="370" height="85" as="geometry" /></mxCell><mxCell id="m_split_calc" value="&lt;b&gt;Fair-Split Mathematical Matrix&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[Financial Calculation Core]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Deterministic split engine: Individual Cost = Private + (Shared / N_guests) + Proportional VAT.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_mesh" vertex="1"><mxGeometry x="25" y="265" width="370" height="85" as="geometry" /></mxCell><mxCell id="m_presence" value="&lt;b&gt;Peer Presence &amp; Heartbeat Daemon&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[Presence Tracker]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Monitors connection health, detects disconnects, and broadcasts real-time participant status.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_mesh" vertex="1"><mxGeometry x="25" y="375" width="370" height="85" as="geometry" /></mxCell><mxCell id="m_reconciler" value="&lt;b&gt;Payment Reconciliation Consumer&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[Event Consumer]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Consumes incoming settlement notifications and pushes `PAID` events to table participants.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_mesh" vertex="1"><mxGeometry x="25" y="485" width="370" height="85" as="geometry" /></mxCell><mxCell id="f_emvco" value="&lt;b&gt;EMVCo Tag Synthesizer&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[EMVCo / VietQR Standard]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Encodes NAPAS 247 payload: Tag 00 (Format), Tag 26 (Bank BIN + Acc), Tag 53 (704 VND), Tag 54 (Amount).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_fintech" vertex="1"><mxGeometry x="25" y="45" width="390" height="85" as="geometry" /></mxCell><mxCell id="f_crc16" value="&lt;b&gt;CRC-16 / CCITT-FALSE Engine&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[Cyclic Redundancy Check]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Calculates standard 16-bit redundancy polynomial 0x1021 ensuring 100% banking scanner compatibility.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_fintech" vertex="1"><mxGeometry x="25" y="155" width="390" height="85" as="geometry" /></mxCell><mxCell id="f_matrix_gen" value="&lt;b&gt;Dynamic QR Matrix Generator&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[ISO 18004 Standard]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Generates crisp vector ISO/IEC 18004 QR codes containing individualized payment data.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_fintech" vertex="1"><mxGeometry x="25" y="265" width="390" height="85" as="geometry" /></mxCell><mxCell id="f_bank_apps" value="&lt;b&gt;Guest Banking Applications&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[Banking Ecosystem]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;40+ NAPAS member banking apps (Vietcombank, Techcombank, VPBank, MBBank, Cake, Timo, etc.).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b1b7ba;strokeWidth=1.2;fontColor=#212529;fontSize=11;align=left;spacingLeft=8;spacingRight=8;arcSize=6;fontFamily=Helvetica,Arial,sans-serif;" parent="sub_fintech" vertex="1"><mxGeometry x="25" y="375" width="390" height="85" as="geometry" /></mxCell><mxCell id="f_napas_mesh" value="&lt;b&gt;Napas 24/7 Interbank Network&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#666666&quot; style=&quot;font-size:10px;&quot;&gt;[Real-Time Clearing]&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;border:0;border-top:1px solid #e9ecef;&quot;/&gt;&lt;font color=&quot;#495057&quot; style=&quot;font-size:11px;&quot;&gt;Facilitates inst